# Rust
target/
**/*.rs.bk
Cargo.lock.orig

# Node / pnpm
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
*.local

# Tauri
crates/openconkit-desktop/gen/

# Staged Codex sidecar binaries (fetched at build time, never committed)
**/binaries/

