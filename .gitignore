branding/icon-1024.png

# Local app data used during development (OPENCONKIT_HOME)
.openconkit/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Env / secrets
.env
.env.*
!.env.example
!.env.sample

# OS noise
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Test / coverage output
coverage/

# Generated binary fixtures (reproducible from source specs)
fixtures/generated/*
!fixtures/generated/.gitkeep
