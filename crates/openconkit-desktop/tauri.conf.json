{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenConKit",
  "version": "0.0.1",
  "identifier": "com.openconkit.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @openconkit/desktop-ui dev",
    "beforeBuildCommand": "pnpm --filter @openconkit/desktop-ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../apps/desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenConKit",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
