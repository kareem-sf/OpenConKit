{
  "name": "openconkit",
  "version": "0.0.1",
  "private": true,
  "description": "The open-source toolkit for construction professionals.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "cd crates/openconkit-desktop && tauri dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test && pnpm test:scripts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "eslint . && node scripts/arch-check.mjs",
    "bundle:check": "node scripts/production-bundle-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p e2e/tsconfig.json",
    "version:sync": "node scripts/version-sync.mjs",
    "version:check": "node scripts/version-check.mjs",
    "arch:check": "node scripts/arch-check.mjs",
    "contracts:check": "node scripts/contracts-check.mjs",
    "contracts:export": "cargo run -p openconkit-contracts-export",
    "codex:fetch": "node scripts/fetch-codex.mjs",
    "portable:package": "node scripts/package-portable.mjs",
    "package:smoke:windows": "powershell -NoProfile -File scripts/smoke-windows-package.ps1 -TargetDirectory target -OutputDirectory output -SmokeParent target",
    "updater:prepare-feed": "node scripts/prepare-update-feed.mjs",
    "fixtures:generate": "cargo run -p openconkit-tool-boq-inspector --example generate_fixtures",
    "tool:new": "node scripts/tool-new.mjs",
    "tool:completeness": "node scripts/tool-completeness-check.mjs",
    "licenses:check": "node scripts/license-check.mjs",
    "notices:generate": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check",
    "security:secrets": "node scripts/secret-scan.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "tauri": "cd crates/openconkit-desktop && tauri"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@openconkit/contracts": "workspace:*",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@wdio/cli": "9.27.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/spec-reporter": "9.27.1",
    "@wdio/tauri-service": "1.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "webdriverio": "9.27.1"
  }
}
